#!/usr/bin/env bash
set -e

# Default values
MAX_FILES=25
GROUP_BY="directory"
WITH_AI=""

# Function to display usage information
usage() {
    echo "Usage: gh split-pr <pr-number> [--max-files=<number>] [--group-by=<strategy>] [--with=<source>]"
    echo
    echo "Options:"
    echo "  --max-files    Maximum number of files per split PR (default: 10)"
    echo "  --group-by     Strategy for grouping files (directory|extension|random|ai) (default: directory)"
    echo "  --with        AI source for advanced grouping (OPENAI|CLAUDE|DEEPSEEK)"
    exit 1
}

# Function to validate and check AI API key
validate_ai_source() {
    local source="$1"
    local api_key_var

    # Validate AI source
    case "$source" in
        OPENAI|CLAUDE|DEEPSEEK)
            # Check if API key is set
            api_key_var="${source}_API_KEY"
            if [[ -z "${!api_key_var}" ]]; then
                echo "Error: ${api_key_var} environment variable is required."
                exit 1
            fi
            ;;
        *)
            echo "Error: Unsupported AI source. Supported sources are: OPENAI, CLAUDE, DEEPSEEK"
            exit 1
            ;;
    esac
}

# Function to call AI API for file grouping
group_files_with_ai() {
    local files="$1"
    local source="$2"
    local api_key_var="${source}_API_KEY"
    local api_key="${!api_key_var}"
    local response=""

    # Prepare prompt for AI
    local prompt="You are an expert at organizing code files into logical, cohesive groups for pull requests.

Given the following list of files, suggest how to split them into smaller, meaningful PRs:

$files

Provide your response as a JSON array of arrays, where each inner array represents a group of files that should be in the same PR.
Reasoning should focus on:
1. Logical code organization
2. Minimal interdependencies between groups
3. Maintaining clear, focused PRs

Example output format:
[
    ['src/module1/file1.py', 'src/module1/file2.py'],
    ['src/module2/file3.js', 'src/module2/file4.js']
]"

    # Call different AI APIs based on source
    case "$source" in
        OPENAI)
            response=$(curl -s https://api.openai.com/v1/chat/completions \
                -H "Content-Type: application/json" \
                -H "Authorization: Bearer $api_key" \
                -d "{
                    \"model\": \"gpt-3.5-turbo\",
                    \"messages\": [{\"role\": \"user\", \"content\": \"$prompt\"}],
                    \"temperature\": 0.7
                }" | jq -r '.choices[0].message.content')
            ;;
        CLAUDE)
            response=$(curl -s https://api.anthropic.com/v1/messages \
                -H "Content-Type: application/json" \
                -H "X-API-Key: $api_key" \
                -d "{
                    \"model\": \"claude-2.1\",
                    \"messages\": [{\"role\": \"user\", \"content\": \"$prompt\"}]
                }" | jq -r '.content[0].text')
            ;;
        DEEPSEEK)
            response=$(curl -s https://api.deepseek.com/v1/chat/completions \
                -H "Content-Type: application/json" \
                -H "Authorization: Bearer $api_key" \
                -d "{
                    \"model\": \"deepseek-chat\",
                    \"messages\": [{\"role\": \"user\", \"content\": \"$prompt\"}],
                    \"temperature\": 0.7
                }" | jq -r '.choices[0].message.content')
            ;;
    esac

    # Validate and parse JSON response
    if echo "$response" | jq -e . >/dev/null 2>&1; then
        echo "$response"
    else
        # Fallback to default grouping if AI response is invalid
        echo "$files" | awk -F'/' '{print $1, $0}' | sort | cut -d' ' -f2-
    fi
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --max-files=*)
            MAX_FILES="${1#*=}"
            shift
            ;;
        --group-by=*)
            GROUP_BY="${1#*=}"
            shift
            ;;
        --with=*)
            WITH_AI="${1#*=}"
            validate_ai_source "$WITH_AI"
            shift
            ;;
        -h|--help)
            usage
            ;;
        *)
            if [[ -z "$PR_NUMBER" ]]; then
                PR_NUMBER="$1"
            else
                echo "Error: Unknown argument $1"
                usage
            fi
            shift
            ;;
    esac
done

# Validate PR number
if [[ -z "$PR_NUMBER" ]]; then
    echo "Error: PR number is required"
    usage
fi

# Validate group-by strategy
if [[ "$GROUP_BY" == "ai" && -z "$WITH_AI" ]]; then
    echo "Error: AI grouping strategy requires specifying an AI source with --with=<source>"
    echo "Available sources: OPENAI, CLAUDE, DEEPSEEK"
    exit 1
fi

if [[ "$GROUP_BY" != "directory" && "$GROUP_BY" != "extension" && "$GROUP_BY" != "random" && "$GROUP_BY" != "ai" ]]; then
    echo "Error: Invalid group-by strategy. Must be one of: directory, extension, random, ai"
    usage
fi

# Get the current repository
REPO=$(gh repo view --json nameWithOwner -q .nameWithOwner)
if [[ -z "$REPO" ]]; then
    echo "Error: Not in a GitHub repository"
    exit 1
fi

echo "Configuration:"
echo "- PR Number: $PR_NUMBER"
echo "- Max Files per PR: $MAX_FILES"
echo "- Grouping Strategy: $GROUP_BY"
if [[ -n "$WITH_AI" ]]; then
    echo "- AI Source: $WITH_AI"
fi
echo "- Repository: $REPO"

# Function to check if required commands are available
check_dependencies() {
    local missing_deps=()
    for cmd in gh jq git; do
        if ! command -v "$cmd" &> /dev/null; then
            missing_deps+=("$cmd")
        fi
    done

    if [[ ${#missing_deps[@]} -gt 0 ]]; then
        echo "Error: Missing required dependencies: ${missing_deps[*]}"
        exit 1
    fi
}

# Check dependencies before proceeding
check_dependencies

# Get PR details
echo "Fetching PR #$PR_NUMBER details..."
PR_DATA=$(gh pr view "$PR_NUMBER" --json title,body,baseRefName,headRefName,files)
if [[ -z "$PR_DATA" ]]; then
    echo "Error: Could not fetch PR #$PR_NUMBER"
    exit 1
fi

# Extract PR information
BASE_BRANCH=$(echo "$PR_DATA" | jq -r .baseRefName)
HEAD_BRANCH=$(echo "$PR_DATA" | jq -r .headRefName)
ORIGINAL_TITLE=$(echo "$PR_DATA" | jq -r .title)
ORIGINAL_BODY=$(echo "$PR_DATA" | jq -r .body)

# Get list of changed files
FILES=$(echo "$PR_DATA" | jq -r '.files[].path')
TOTAL_FILES=$(echo "$FILES" | wc -l)

echo
echo "PR Details:"
echo "- Title: $ORIGINAL_TITLE"
echo "- Base Branch: $BASE_BRANCH"
echo "- Head Branch: $HEAD_BRANCH"
echo "- Total Files Changed: $TOTAL_FILES"

# Function to group files based on strategy
group_files() {
    local files="$1"

    # If AI grouping is selected, use AI-powered grouping
    if [[ "$GROUP_BY" == "ai" && -n "$WITH_AI" ]]; then
        group_files_with_ai "$files" "$WITH_AI"
        return
    fi

    # Default grouping strategies
    case "$GROUP_BY" in
        "directory")
            # Group by top-level directory
            echo "$files" | awk -F'/' '{
                if (NF > 1) print $1, $0
                else print "root", $0
            }' | sort | cut -d' ' -f2-
            ;;
        "extension")
            # Group by file extension
            echo "$files" | awk -F'.' '{
                if (NF > 1) print $NF, $0
                else print "no_ext", $0
            }' | sort | cut -d' ' -f2-
            ;;
        "random")
            # Random distribution
            echo "$files" | shuf
            ;;
        *)
            # Default to directory if unknown strategy
            echo "$files" | awk -F'/' '{
                if (NF > 1) print $1, $0
                else print "root", $0
            }' | sort | cut -d' ' -f2-
            ;;
    esac
}

# Create temporary directory for file operations
TEMP_DIR=$(mktemp -d)
trap 'rm -rf "$TEMP_DIR"' EXIT

# Group the files
echo "Grouping files by $GROUP_BY..."
GROUPED_FILES=$(group_files "$FILES")

# Function to preview the split
preview_split() {
    local files="$1"
    local batch_size="$2"
    local current_count=0
    local batch_number=1
    local current_batch=""

    echo "Preview of PR split:"
    echo "-------------------"
    echo "Using strategy: $GROUP_BY"
    echo "Maximum files per PR: $batch_size"
    echo

    while IFS= read -r file; do
        current_batch+="$file"$'\n'
        current_count=$((current_count + 1))

        if [[ $current_count -eq $batch_size ]]; then
            echo "Batch $batch_number (${current_count} files):"
            echo "$current_batch"
            echo "-------------------"

            current_batch=""
            current_count=0
            batch_number=$((batch_number + 1))
        fi
    done <<< "$files"

    # Handle remaining files if any
    if [[ -n "$current_batch" ]]; then
        echo "Batch $batch_number ($current_count files):"
        echo "$current_batch"
        echo "-------------------"
    fi

    echo
    echo "Total number of PRs that will be created: $((batch_number))"
}

echo "Preparing to split PR into batches of up to $MAX_FILES files..."
echo "Total files to process: $TOTAL_FILES"

# Preview the split
preview_split "$GROUPED_FILES" "$MAX_FILES"

# Ask for user confirmation
read -p "Do you want to proceed with this split? (y/N) " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Operation cancelled by user"
    exit 0
fi

# Initialize counters and arrays
CURRENT_COUNT=0
BATCH_NUMBER=1
declare -a NEW_PRS=()

# Function to create a new PR
create_split_pr() {
    local batch_num=$1
    local files_list=$2

    echo "Creating PR batch $batch_num with $(echo "$files_list" | wc -l) files..."

    # Create new branch for this batch
    local batch_branch="split-pr-$PR_NUMBER-batch-$batch_num"
    git checkout -b "$batch_branch" "origin/$BASE_BRANCH"

    # Copy files from original PR
    while IFS= read -r file; do
        # Create directory structure if needed
        mkdir -p "$TEMP_DIR/$(dirname "$file")"
        # Get file content from original PR branch
        git show "origin/$HEAD_BRANCH:$file" > "$TEMP_DIR/$file" || {
            echo "Warning: Could not get content for $file"
            continue
        }
    done <<< "$files_list"

    # Copy files to working directory
    cp -r "$TEMP_DIR"/* . || true

    # Stage and commit changes
    git add .
    git commit -m "Split PR #$PR_NUMBER - Batch $batch_num

Part of original PR: #$PR_NUMBER
Files in this batch: $(echo "$files_list" | wc -l)"

    # Push branch
    git push origin "$batch_branch"

    # Create PR
    local pr_url=""
    pr_url=$(gh pr create \
        --title "[$batch_num] $ORIGINAL_TITLE" \
        --body "Part $batch_num of original PR #$PR_NUMBER

This PR contains a subset of changes from the original PR #$PR_NUMBER.

## Files in this batch:
$(echo "$files_list" | sed 's/^/- /')

---

Original description:
$ORIGINAL_BODY" \
        --base "$BASE_BRANCH" \
        --head "$batch_branch")

    echo "$pr_url"
}

# Process files in batches
current_batch=""
while IFS= read -r file; do
    current_batch+="$file"$'\n'
    CURRENT_COUNT=$((CURRENT_COUNT + 1))

    if [[ $CURRENT_COUNT -eq $MAX_FILES ]]; then
        # Create PR for current batch
        new_pr_url=""
        new_pr_url=$(create_split_pr "$BATCH_NUMBER" "$current_batch")
        NEW_PRS+=("$new_pr_url")

        # Reset for next batch
        current_batch=""
        CURRENT_COUNT=0
        BATCH_NUMBER=$((BATCH_NUMBER + 1))

        # Safely remove contents of temp directory
        if [[ -n "${TEMP_DIR:?}" ]]; then
            rm -rf "${TEMP_DIR:?}"/*
        fi
    fi
done <<< "$GROUPED_FILES"

# Handle remaining files if any
if [[ -n "$current_batch" ]]; then
    new_pr_url=""
    new_pr_url=$(create_split_pr "$BATCH_NUMBER" "$current_batch")
    NEW_PRS+=("$new_pr_url")
fi

# Update original PR with links to new PRs
echo "Updating original PR with links to new PRs..."
NEW_PR_LINKS=""
for pr in "${NEW_PRS[@]}"; do
    NEW_PR_LINKS+="- $pr"$'\n'
done

gh pr edit "$PR_NUMBER" --body "This PR has been split into smaller PRs:

$NEW_PR_LINKS
---

Original description:
$ORIGINAL_BODY"

echo
echo "Successfully split PR #$PR_NUMBER into ${#NEW_PRS[@]} smaller PRs:"
for pr in "${NEW_PRS[@]}"; do
    echo "- $pr"
done
